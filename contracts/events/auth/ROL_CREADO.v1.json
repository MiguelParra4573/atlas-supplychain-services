{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-supplychain/contracts/events/auth/ROL_CREADO.v1.json",
  "title": "ROL_CREADO",
  "description": "Payload del evento ROL_CREADO, publicado por auth-server via outbox en la misma transaccion que el alta del rol.",
  "type": "object",
  "required": ["idRole", "idCompany", "name", "state"],
  "properties": {
    "idRole": { "type": "string" },
    "idCompany": { "type": "string" },
    "name": { "type": "string" },
    "state": { "type": "string", "enum": ["true", "false"] }
  }
}
