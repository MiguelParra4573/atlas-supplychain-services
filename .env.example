# Copiar a .env (ignorado por git) y ajustar. Claves de 24 caracteres al azar (dev-kit/generar-clave.ps1); iguales a las de platform/.env. Nunca usar en producción.
POSTGRES_DB=atlas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# Puerto en el host, bloque 151xx de este proyecto. Tiene que coincidir con
# platform/.env. Al correr desde el IDE:
#   DB_URL=jdbc:postgresql://localhost:15100/atlas
POSTGRES_PORT=15100

AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=

RABBITMQ_PORT=15110
RABBITMQ_USER=atlas
RABBITMQ_PASSWORD=

# auth-server: contexto demo carga usuarios de prueba (admin.atlas)
LIQUIBASE_CONTEXTS=demo

# Puerto en el host (offset +20).
REDIS_PORT=15120

# Correo de prueba: el SMTP de mailpit que publica platform/.
MAIL_PORT=15140

REDIS_PASSWORD=