# Copiar a .env (ignorado por git) y ajustar. Valores de desarrollo local; nunca usar en producción.
POSTGRES_DB=atlas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Puerto en el host. Cambiarlo si 5432 está ocupado (y usar DB_URL=jdbc:postgresql://localhost:<puerto>/atlas al correr desde el IDE).
POSTGRES_PORT=5432

AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=auth_pass

RABBITMQ_USER=atlas
RABBITMQ_PASSWORD=atlas

# auth-server: contexto demo carga usuarios de prueba (admin.atlas)
LIQUIBASE_CONTEXTS=demo

# puerto en el host. Cambiarlo si 6379 está ocupado.
REDIS_PORT=6379
